# ============================================================
# ハッカソン質問対応 Bot の環境変数
# このファイルをコピーして .env を作り、実際の値を入れること。
# .env は .gitignore 済み。絶対にコミットしない。
# ============================================================

# ---- 段階1で必要 ----------------------------------------

# 動作対象のサーバー ID。
# ⚠️ テスト用と本番で同じ Bot を使う場合は必ず設定すること。
#    未設定だと、Bot が参加している全サーバーで動作し、
#    テストサーバーの質問に応答したり、テストのエスカレーションが
#    本番のキューチャンネルへ飛んだりする。
# サーバー名を右クリック →「IDをコピー」
GUILD_ID=

# Discord Bot トークン(Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# 「開発相談室」フォーラムチャンネルの名前。
# 22 チーム分の ID を手で集めるのは非現実的なので、名前で拾う。
# 全チームのフォーラムをこの名前で統一しておくこと。
FORUM_CHANNEL_NAME=エンジニア相談室

# 特定のフォーラムだけに絞りたいときだけ、ID をカンマ区切りで書く。
# 書いた場合は名前より優先される。通常は空のままでよい。
FORUM_CHANNEL_IDS=


# ---- 段階2以降で必要 ------------------------------------

# Anthropic API キー(https://console.anthropic.com)
ANTHROPIC_API_KEY=

# 参加者への回答に使うモデル。画像(スクショ)読み取りに対応している必要がある。
ANTHROPIC_MODEL=claude-opus-5

# エスカレーション時の要約生成に使うモデル。軽い処理なので下位モデルでよい。
# 要約の質を上げたい場合は claude-sonnet-5 に変更する。
ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5

# 安全上の判断でモデルが応答を拒否した場合に、同じリクエストの中で引き継ぐモデル。
# 空にすると無効になる(その場合は拒否がそのままエラーになる)。
ANTHROPIC_FALLBACK_MODEL=claude-opus-4-8

# 思考の深さと消費トークンの度合い: low | medium | high | xhigh | max
# 検証の結果、low と medium で回答品質に差が出ず、low のほうが約1.4秒速かった。
# コスト差はわずか(6.7%)。固定費であるキャッシュ読込が半分を占めるため。
ANTHROPIC_EFFORT=low

# 1回の回答の出力トークン上限(コスト暴走の防御。SPEC §8.3)。
# Discord は 2000 字で分割送信されるが、そもそも長い回答は読まれない。
ANTHROPIC_MAX_TOKENS=2000

# 要約の出力トークン上限
SUMMARY_MAX_TOKENS=1000

# 1つの投稿から文脈として渡すメッセージの最大件数(コスト暴走の防御。SPEC §8.3)。
# 投稿の1件目(質問本体)は、この上限を超えても必ず含まれる。
HISTORY_LIMIT=20

# LLM 呼び出しのタイムアウト秒数と再試行回数。
# SDK の既定は 600 秒 / 2 回だが、参加者を待たせすぎるので短くしている。
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1

# 知識源とシステムプロンプトの場所(通常は変更不要)
KNOWLEDGE_DIR=./knowledge
SYSTEM_PROMPT_PATH=./prompts/system_prompt.md


# ---- 段階4以降で必要 ------------------------------------

# 「エンジニアメンター」ロールの ID。
# ⚠️ 「メンター」ロールの ID を入れないこと。デザイナーメンターに通知が飛ぶ。
ENGINEER_MENTOR_ROLE_ID=

# エンジニアメンター用キューチャンネルの ID(参加者には非公開にすること)
MENTOR_QUEUE_CHANNEL_ID=

# フォーラムに付ける「要対応」タグの名前(タグはフォーラム設定から手動作成する)
NEEDS_ATTENTION_TAG_NAME=要対応

# 対応中のまま自動で未対応に戻すまでの分数
ESCALATION_TIMEOUT_MINUTES=30


# ---- 段階6以降で必要 ------------------------------------

# 「Bot管理」チャンネル。
# 全質疑応答がここに流れ、「共有ナレッジに追加」ボタンが付く(SPEC §4.2)。
# これが質問ログを兼ねるので、別途ログチャンネルは作らない。
ADMIN_CHANNEL_ID=

# レート制限(SPEC §8.2「普通に使えば絶対に当たらない」水準)
RATE_LIMIT_PER_CHANNEL_HOURLY=40
RATE_LIMIT_PER_USER_SECONDS=5

# 累積コストがこの金額($)を超えたら Bot管理 チャンネルへアラートを出す。
# これがあるから、参加者側のレート制限は緩くしていられる(SPEC §8.4)。
USAGE_ALERT_THRESHOLDS=10,25,50,100,200


# ---- 永続化 ---------------------------------------------

# SQLite ファイルのパス。
# ⚠️ Railway では必ず Volume のマウントポイント配下を指すこと(例: /data/bot.db)。
#    Volume の外に置くと再デプロイのたびにデータが消える。
DB_PATH=./data/bot.db


# ---- 開発用 ---------------------------------------------

# DEBUG にすると discord.py の詳細ログが出る
LOG_LEVEL=INFO

# ログの時刻を日本時間にする。
# ローカル(Mac)では不要。Railway のコンテナは UTC で動くため、
# デプロイ先で設定しておくと障害時にログを追いやすい。
# Bot の時刻処理(30分の期限など)には影響しない。
TZ=Asia/Tokyo
